              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Admin\",\n  \"email\": \"demo.admin@university.edu\",\n  \"username\": \"demo_admin\",\n  \"password\": \"demo123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"password is NOT in the response\", function () { pm.expect(pm.response.json()).to.not.have.property(\"password\"); });",
                  "pm.collectionVariables.set(\"demoAdminId\", pm.response.json().id);"
